# Base path of the deployed site. Must match the GitHub Pages project path.
# For https://alex-beng.github.io/cubingchina-oldstyle/ keep the default.
VITE_BASE_PATH=/cubingchina-oldstyle/

# api.cubing.com does not send Access-Control-Allow-Origin for third-party
# origins, so browser calls must go through a proxy.
# Set this to the deployed Cloudflare Worker URL, e.g.
#   VITE_CUBING_API_BASE=https://cubingchina-oldstyle-proxy.<account>.workers.dev
# When empty, the site requests /cubing-api/* which only works behind the
# Vite dev/preview proxy.
VITE_CUBING_API_BASE=

# wca-api.cubing.com sends Access-Control-Allow-Origin: * and can be called
# directly. Override only if you put it behind a proxy too.
VITE_WCA_API_BASE=https://wca-api.cubing.com

# Set to 1 to call https://api.cubing.com directly (only works if CORS is
# relaxed upstream or when the site is served from an allowed origin).
VITE_CUBING_API_DIRECT=0
