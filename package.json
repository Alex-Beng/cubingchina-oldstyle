{
  "name": "cubingchina-oldstyle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Legacy CubingChina UI rebuilt as a read-only static site on top of the public Cubing China API",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:styles && vue-tsc --noEmit && vite build",
    "build:styles": "node scripts/build-styles.mjs",
    "build:snapshot": "node scripts/fetch-snapshot.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "convert:messages": "node scripts/convert-messages.mjs"
  },
  "dependencies": {
    "bootstrap": "^3.4.1",
    "echarts": "^5.5.1",
    "font-awesome": "^4.7.0",
    "leaflet": "^1.9.4",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.6.0",
    "autoprefixer": "^10.4.20",
    "less": "^4.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.49",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vue-tsc": "^2.1.10"
  }
}
